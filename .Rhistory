names_to = "SampleID",
values_to = "Meas"
)
## pivot longer--------------------
pl_long <- pl %>%
pivot_longer(
cols = c(sample_1, sample_2),
names_to = "sampleID",
values_to = "meas"
)
# create new column to hold calculated values
pl_long$Ecoli_1dGM <- 0
pl_long$Ecoli_30dGM <- 0
# make list of beaches to loop through
beachlist <- unique(pl_long$beachName)
# new dataframe to put data in
pl <- data.frame()
# loop through list of beaches and calcualte 30day GM
for (i in 1:length(beachlist)) {
# select one beach
beach <- pl_long %>%
filter(beach_name == beachlist[i])
# manipulate only that beach to calculate geometric means
for (i in 1:length(beach$date)) {
intervalstart <- as.POSIXct(beach$date[i] - 30) # start 30 days before sampling date
intervalend <-  as.POSIXct(beach$date[i])
# select all E coli measurements for one day
oneday <-  beach %>%
filter(date == intervalend)
# calculate 1 day geometric mean and add it to column in df
beach$Ecoli_1dGM[i] <- round(geomean(oneday$meas, na.rm = TRUE), digits = 1)
# select all E coli measurements in range
span30d <-  beach %>%
filter(date >= intervalstart & date <= intervalend)
# calculate 30-day geometric mean and add it to column in df
beach$Ecoli_30dGM[i] <- round(geomean(span30d$meas, na.rm = TRUE), digits = 1)
}
# beach <- beach %>%
#   select(beachName, date, Ecoli_1dGM, Ecoli_30dGM) %>%
#   distinct()
pl <- bind_rows(pl, beach) # recombine beaches
}
pl <- pl %>%
select(-average, -geometric_mean)
