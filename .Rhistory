beaches_newthresh <- beaches   %>%
mutate(
ClosureYN = if_else(
condition = Ecoli_1dGM > 235,
true = "Y",
false = "N")
) %>%
mutate(
ClosureReason = if_else(
condition = Ecoli_1dGM > 235,
true = "ecoli_1dayGM",
false = NA)
) %>%
mutate(
ClosureYN = if_else(
condition = Ecoli_30dGM > 126,
true = "Y",
false = "N")
) %>%
mutate(
ClosureReason = if_else(
condition = Ecoli_30dGM > 126,
true = "ecoli_30dayGM",
false = NA)
)
