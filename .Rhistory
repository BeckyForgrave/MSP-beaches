clim$ante48htotp <- 0
clim$ante48hmaxt <- 0
# rolling  48hr day climate
for (i in 1:length(dclim$date)) {
intervalstart <- as.POSIXct(clim$date[i] - 2) #rolling window 5 days before
intervalend <-  as.POSIXct(clim$date[i])
span48h <-  clim %>%
filter(date >= intervalstart & date <= intervalend) # select all data 2 days
clim$ante48htotp[i] <- sum(span48h$precip_in, na.rm = TRUE)
clim$ante48hmaxt[i] <- mean(span48h$max_temp_F, na.rm = TRUE)
}
