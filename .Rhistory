geomean <- function(df, window) {
row_count <- nrow(df)
output_vector <- as.numeric(df)
new_col <- paste(window, "d_GM", sep = "")
for (i seq_len(row_count)) {
geomean <- function(df, window) {
row_count <- nrow(df)
output_vector <- as.numeric(df)
new_col <- paste(window, "d_GM", sep = "")
for (i in seq_len(row_count)) {
index_match <-
df$Date >= as_date(df$Date[i]) - 30 &
df$Date <= as_date(df$Date[i])
n_count <- length(which(index_match == TRUE))
calc_prod <- prod(
df$Meas_value[index_match],
na.rm = TRUE
)
calc_base <- calc_prod^(1/n_count)
output_vector[i] <- calc_base
}  # end "for" loop
}  # end function
